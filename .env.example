DATABASE_URL="mysql://root@127.0.0.1:3307/store_dev"
G2BULK_API_KEY=""
G2BULK_BASE_URL="https://api.g2bulk.com"
G2BULK_WEBHOOK_SECRET=""
PAYMENT_PROVIDER="fake"
AUTH_SECRET=""
ADMIN_PASSWORD=""
JOBS_SECRET=""
ALLOW_FAKE_FULFILMENT="false"
ALLOW_FAKE_PAYMENTS="false"
# Runtime overrides (no restart): files ./fake-payments and ./fake-fulfilment containing true/false.
# The ALLOW_FAKE_* env values above are the fallbacks when those files are absent.

# Paymob (card + wallet). Required only when PAYMENT_PROVIDER="paymob".
PAYMOB_API_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_INTEGRATION_ID_CARD=""
PAYMOB_INTEGRATION_ID_WALLET=""
PAYMOB_HMAC_SECRET=""
PAYMOB_SECRET_KEY=""
PAYMOB_BASE_URL="https://accept.paymob.com"
# Absolute public base URL used to build payment return/callback URLs, e.g. https://67-store.online
APP_URL=""

# Branding (public; baked in at `next build` — rebuild after changing)
NEXT_PUBLIC_BRAND_NAME="67 Store"
NEXT_PUBLIC_BRAND_NAME_AR="٦٧ ستور"
NEXT_PUBLIC_BRAND_SHORT="67"
NEXT_PUBLIC_BRAND_SUFFIX=" Store"
NEXT_PUBLIC_BRAND_ICON=/brand-67.png
NEXT_PUBLIC_BRAND_COIN="67 Coins"
NEXT_PUBLIC_BRAND_COIN_AR="عملات ٦٧"
NEXT_PUBLIC_BRAND_HELP="67 Help"
NEXT_PUBLIC_BRAND_HELP_AR="مساعدة ٦٧"
NEXT_PUBLIC_BRAND_ADMIN_LABEL="إدارة ٦٧"
NEXT_PUBLIC_BRAND_DOMAIN="67.store"
NEXT_PUBLIC_BRAND_LOGO_64="/logo-64.png"
NEXT_PUBLIC_BRAND_LOGO_128="/logo-128.png"
NEXT_PUBLIC_BRAND_LOGO_256="/logo-256.png"
NEXT_PUBLIC_BRAND_COIN_64="/coin-64.png"
NEXT_PUBLIC_BRAND_COIN_128="/coin-128.png"
NEXT_PUBLIC_BRAND_COIN_256="/coin-256.png"

# Site-wide access gate (src/middleware.ts). Set true to require Basic auth.
# Credentials are in gate-users.txt (hand-editable, git-ignored). Empty list = deny all.
GATE_ENABLED=false
# Optional: override the credentials file path (default: ./gate-users.txt).
# GATE_USERS_FILE=
# How long a successful login is remembered, in seconds (default 7200 = 120 min).
GATE_COOKIE_TTL=7200
# Optional secret used to sign the session cookie. Falls back to AUTH_SECRET.
# GATE_COOKIE_SECRET=
# Runtime gate on/off switch file (contents "true" or "false"). Falls back to GATE_ENABLED.
# GATE_FLAG_FILE=

